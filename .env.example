# Configure apenas o segredo primeiro: recebe diagnóstico sem gravar compras.
# Adicione o ID real do produto depois de conferir o teste nos logs.
# LASTLINK_PRODUCT_ID=ID-REAL-DO-PRODUTO
# Para gravar também os Reels presentes no evento de compra conjunta:
# LASTLINK_REELS_PRODUCT_ID=167648e6-49ce-41c7-893f-49a97cf258ba
# Requer a tabela reels_compras, criada pelo serviço Reels no mesmo banco.
# LASTLINK_TOKEN=TOKEN-DO-WEBHOOK-NO-PAINEL-LASTLINK
# LASTLINK_WEBHOOK_SECRET=64-CARACTERES-HEX-GERADOS-COM-OPENSSL
